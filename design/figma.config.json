    "servers": {
      "pat-rest-api": {
        "role": "read",
        "priority": 1,
        "note": "FIGMA_API_KEY + Figma REST API；Starter 批量读主力，不限 MCP 6 次/月"
      },
      "figma-link": {
        "role": "read",
        "priority": 2,
        "note": "粘贴 Frame 链接 + resolve-figma-screen.js 解析 nodeId"
      },
      "figma": {
        "url": "https://mcp.figma.com/mcp",
        "role": "read-write",
        "priority": 3,
        "note": "Remote OAuth；读约 6 次/月；写 use_figma / generate_figma_design 免限额"
      },
      "plugin-figma-figma": {
        "role": "read-write",
        "priority": 4,
        "note": "Cursor Figma 插件；写 use_figma / generate_figma_design + Skills"
      },
      "figma-desktop": {
        "url": "http://127.0.0.1:3845/mcp",
        "role": "read",
        "priority": 5,
        "optional": true,
        "note": "需付费 Dev Seat；Starter 仅 WARN"
      }
    },
    "agentRouting": {
      "figmaToCode": ["pat-rest-api", "figma-link", "figma", "figma-desktop"],
      "codeToFigma": ["figma", "plugin-figma-figma", "figma-desktop"]
    },
    "verifyScript": "scripts/verify-figma-mcp.ps1",
    "resolveScript": "scripts/resolve-figma-screen.js"
  }
